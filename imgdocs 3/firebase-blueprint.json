{
  "entities": {
    "Conversion": {
      "title": "Conversion Record",
      "description": "Log of a PDF or image conversion operation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique Firebase Auth user ID" },
        "tool": { "type": "string", "description": "The tool identifier, e.g., jpg_to_pdf" },
        "fileName": { "type": "string", "description": "Original file name" },
        "fileSize": { "type": "string", "description": "Formatted file size string" },
        "pageCount": { "type": "number", "description": "Number of pages processed" },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO timestamp of the conversion" }
      },
      "required": ["userId", "tool", "fileName", "fileSize", "pageCount"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile with premium status and subscription plan details",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User email address" },
        "isPremium": { "type": "boolean", "description": "Whether the user has active premium access" },
        "subscriptionPlan": { "type": "string", "description": "Active subscription plan name (free, pro_monthly, pro_yearly, business_monthly, business_yearly)" },
        "subscriptionStatus": { "type": "string", "description": "Current status of subscription (active, cancelled)" },
        "renewalDate": { "type": "string", "description": "Renewal or expiry date" },
        "paymentHistory": { "type": "array", "description": "List of invoices and payment receipts" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" }
      },
      "required": ["email", "isPremium", "subscriptionPlan"]
    },
    "SubscriptionOrder": {
      "title": "Subscription Order",
      "description": "A payment checkout order pending backend authorization",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User requesting checkout" },
        "orderId": { "type": "string", "description": "Unique identifier of order" },
        "planId": { "type": "string", "description": "Target subscription plan" },
        "amount": { "type": "number", "description": "Checkout price in INR" },
        "status": { "type": "string", "enum": ["pending", "paid", "failed"], "description": "Current status of checkout" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orderId", "planId", "amount", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription authorization credentials generated by server",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plan": { "type": "string" },
        "paymentId": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "plan", "paymentId", "orderId", "paymentStatus", "amount", "currency", "purchaseDate", "expiryDate", "isActive"]
    }
  },
  "firestore": {
    "/conversions/{conversionId}": {
      "schema": "Conversion",
      "description": "Stores document conversion records"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records containing premium and billing credentials"
    },
    "/subscription_orders/{orderId}": {
      "schema": "SubscriptionOrder",
      "description": "Active checkout records pending verification"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Official server-verified premium active memberships"
    }
  }
}
