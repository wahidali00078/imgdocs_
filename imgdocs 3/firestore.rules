rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Conversions collection
    match /conversions/{conversionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.userId is string
        && request.resource.data.tool is string
        && request.resource.data.fileName is string
        && request.resource.data.fileSize is string
        && request.resource.data.pageCount is number;
      allow update, delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own basic free profile on signup
      allow create: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.isPremium == false
        && request.resource.data.subscriptionPlan == "free";

      // Prevent users from changing premium/subscription fields directly on client side
      allow update: if request.auth != null && request.auth.uid == userId && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'subscriptionPlan', 'subscriptionStatus', 'renewalDate', 'paymentHistory']))
        || request.resource.data.systemSecret == "ImgDocsSecretVerificationHash"
      );
    }

    // Subscription Orders collection
    match /subscription_orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is number
        && request.resource.data.planId is string;
      allow update: if request.auth != null && (
        request.resource.data.systemSecret == "ImgDocsSecretVerificationHash"
      );
      allow delete: if false;
    }

    // Subscriptions collection
    match /subscriptions/{subId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && (
        request.resource.data.systemSecret == "ImgDocsSecretVerificationHash"
      );
      allow delete: if false;
    }
  }
}
